// Shared UI for the desktop (ojp) and Android (ojp-android) apps.
// Pure view: state lives in Rust and is pushed in through the `Chat` and
// `Settings` globals; user actions come back out through their callbacks.
import { Button, CheckBox, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, Switch } from "std-widgets.slint";

export struct Message {
    from-user: bool,
    // Raw text, as typed or as streamed from the model.
    text: string,
    // Assistant replies rendered from `text` (markdown; LaTeX math turned
    // into Unicode by ojp-core::format) by the Rust side.
    rendered: styled-text,
    // Small grey line under a reply: route, timing, notices.
    meta: string,
}

export struct ChatSummary {
    id: string,
    title: string,
}

export global Chat {
    in-out property <string> assistant-name: "Jarvis";
    in-out property <[Message]> messages;
    // True while a reply is being generated; input is disabled meanwhile.
    in-out property <bool> busy;
    // One-line status under the header (models loaded, errors).
    in-out property <string> status;
    callback send(string);
    callback clear();

    // Saved chats, most recent first, and the one on screen.
    in-out property <[ChatSummary]> chats;
    in-out property <string> current-chat;
    callback open-chat(string);
    callback delete-chat(string);

    // First-run model download panel.
    in-out property <bool> download-needed;
    in-out property <string> download-text;
    // 0..1 while downloading; negative when not running (shows the button).
    in-out property <float> download-progress: -1;
    // Storage choices (e.g. "Phone storage (54.2 GB free)", "SD card (…)");
    // empty means a single Download button.
    in-out property <[string]> download-targets;
    // Index into download-targets, or -1 for the single button.
    callback download(int);
    // "Also download the main model" checkbox: shown when the main model is
    // among the missing ones; unticked means router only.
    in-out property <bool> offer-main;
    in-out property <string> main-label;
    in-out property <bool> download-main: true;
}

export global Settings {
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme;
    in-out property <bool> dynamic-colors: true;
    // Only Android has wallpaper-based colours.
    in-out property <bool> dynamic-colors-supported;
    // Developer: false = router only, the main model is never loaded.
    in-out property <bool> main-enabled: true;
    // Read-only details shown in the developer section.
    in-out property <string> info;
    // Any of the above changed by the user; the host saves and applies it.
    callback changed();
}

component IconButton inherits Rectangle {
    in property <image> icon;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Palette.alternate-background : transparent;
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        colorize: Palette.foreground;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Bubble inherits Rectangle {
    in property <Message> message;
    background: message.from-user ? Palette.accent-background : Palette.alternate-background;
    border-radius: 14px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        if message.from-user: Text {
            text: message.text;
            wrap: word-wrap;
            color: Palette.accent-foreground;
        }
        if !message.from-user: StyledText {
            text: message.rendered;
            default-color: Palette.foreground;
            link-color: Palette.accent-background;
        }
        if message.meta != "": Text {
            text: message.meta;
            wrap: word-wrap;
            font-size: 0.8rem;
            color: message.from-user ? Palette.accent-foreground : Palette.foreground;
            opacity: 0.6;
        }
    }
}

component ChatPage inherits Rectangle {
    callback open-menu;
    background: Palette.background;

    function submit() {
        if (input.text != "" && !Chat.busy) {
            Chat.send(input.text);
            input.text = "";
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 4px;
            vertical-stretch: 0;
            IconButton {
                icon: @image-url("../assets/menu.png");
                clicked => { root.open-menu(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: Chat.assistant-name;
                    font-size: 1.4rem;
                    font-weight: 700;
                }
                if Chat.status != "": Text {
                    text: Chat.status;
                    font-size: 0.8rem;
                    opacity: 0.6;
                    overflow: elide;
                }
            }
            Button {
                text: "New chat";
                enabled: !Chat.busy;
                clicked => { Chat.clear(); }
            }
        }

        // Not a ListView: a ListView only instantiates visible rows and
        // re-estimates its height while scrolling, which the auto-scroll
        // below then mistook for new content (you couldn't scroll up).
        list := ScrollView {
            vertical-stretch: 1;
            // Follow new text only while the user is at the bottom; scrolling
            // up to read older messages stops following.
            property <bool> follow: true;
            scrolled => {
                self.follow = self.content-y <= self.visible-height - self.content-height + 24px;
            }
            changed content-height => {
                if (self.follow) {
                    self.content-y = min(0px, self.visible-height - self.content-height);
                }
            }
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: start;
                for message in Chat.messages: HorizontalLayout {
                    // Indent from the opposite side so user and assistant
                    // messages read as two columns.
                    padding-left: message.from-user ? 56px : 12px;
                    padding-right: message.from-user ? 12px : 56px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Bubble { message: message; }
                }
            }
        }

        if Chat.download-needed: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            vertical-stretch: 0;
            Rectangle {
                background: Palette.alternate-background;
                border-radius: 14px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: Chat.download-text;
                        wrap: word-wrap;
                    }
                    // CheckBox text can't wrap (it would widen the panel past a
                    // phone screen), so the label is a separate wrapping Text
                    // that toggles the box too.
                    if Chat.download-progress < 0 && Chat.offer-main: HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            horizontal-stretch: 0;
                            checked <=> Chat.download-main;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: Chat.main-label;
                                    wrap: word-wrap;
                                }
                            }
                            TouchArea {
                                clicked => { Chat.download-main = !Chat.download-main; }
                            }
                        }
                    }
                    if Chat.download-progress >= 0: ProgressIndicator {
                        progress: Chat.download-progress;
                    }
                    if Chat.download-progress < 0 && Chat.download-targets.length == 0: Button {
                        text: "Download";
                        primary: true;
                        clicked => { Chat.download(-1); }
                    }
                    if Chat.download-progress < 0: VerticalLayout {
                        spacing: 8px;
                        for target[index] in Chat.download-targets: Button {
                            text: target;
                            primary: index == 0;
                            clicked => { Chat.download(index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            vertical-stretch: 0;
            input := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Message " + Chat.assistant-name;
                enabled: !Chat.busy;
                accepted => { root.submit(); }
            }
            Button {
                text: "Send";
                enabled: !Chat.busy && input.text != "";
                clicked => { root.submit(); }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    callback close;
    callback open-settings;
    background: Palette.alternate-background;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: "Chats";
            font-size: 1.3rem;
            font-weight: 700;
        }
        Button {
            text: "New chat";
            primary: true;
            enabled: !Chat.busy;
            clicked => {
                Chat.clear();
                root.close();
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                if Chat.chats.length == 0: Text {
                    text: "No saved chats yet.";
                    opacity: 0.6;
                }
                for chat in Chat.chats: Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: chat.id == Chat.current-chat ? Palette.control-background : (row-touch.pressed ? Palette.background : transparent);
                    row-touch := TouchArea {
                        enabled: !Chat.busy;
                        clicked => {
                            Chat.open-chat(chat.id);
                            root.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 4px;
                        Text {
                            horizontal-stretch: 1;
                            text: chat.title;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        IconButton {
                            icon: @image-url("../assets/delete.png");
                            clicked => { Chat.delete-chat(chat.id); }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 44px;
            border-radius: 10px;
            background: settings-touch.pressed ? Palette.background : transparent;
            settings-touch := TouchArea {
                clicked => { root.open-settings(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                spacing: 10px;
                Image {
                    source: @image-url("../assets/settings.png");
                    width: 22px;
                    colorize: Palette.foreground;
                }
                Text {
                    text: "Settings";
                    vertical-alignment: center;
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.title; }
        if root.description != "": Text {
            text: root.description;
            wrap: word-wrap;
            font-size: 0.85rem;
            opacity: 0.65;
        }
    }
    Switch {
        horizontal-stretch: 0;
        checked <=> root.checked;
        toggled => { root.toggled(); }
    }
}

component SettingsPage inherits Rectangle {
    callback back;
    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 0;
            Button {
                text: "‹ Back";
                horizontal-stretch: 0;
                clicked => { root.back(); }
            }
            Text {
                text: "Settings";
                font-size: 1.3rem;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        ScrollView {
            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                alignment: start;

                Text { text: "Appearance"; font-weight: 700; color: Palette.accent-background; }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Theme";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: ["System", "Light", "Dark"];
                        current-index <=> Settings.theme;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.dynamic-colors-supported: SettingRow {
                    title: "Dynamic colours";
                    description: "Tint the app with your wallpaper's colours.";
                    checked <=> Settings.dynamic-colors;
                    toggled => { Settings.changed(); }
                }

                Rectangle { height: 1px; background: Palette.border; opacity: 0.4; }

                Text { text: "Developer"; font-weight: 700; color: Palette.accent-background; }
                SettingRow {
                    title: "Use the main model";
                    description: "Off: only the small router model is loaded and answers everything (less memory, weaker answers).";
                    checked <=> Settings.main-enabled;
                    toggled => { Settings.changed(); }
                }
                Text {
                    text: Settings.info;
                    wrap: word-wrap;
                    font-size: 0.8rem;
                    opacity: 0.65;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    // App name; the assistant's own name (persona) is shown in the header.
    title: "OpenJarvis";
    icon: @image-url("../assets/openjarvis-256.png");
    preferred-width: 440px;
    preferred-height: 760px;
    background: Palette.background;

    property <int> theme: Settings.theme;
    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    property <bool> show-settings;
    property <length> drawer-width: min(320px, root.width * 0.82);
    property <bool> drawer-open;
    // Where the drawer rests (0 = closed, drawer-width = open), animated
    // when it changes, plus the live finger offset while swiping. On
    // release the offset eases back to 0 while the resting position eases
    // to its new value, so the drawer continues from under the finger
    // instead of jumping (Slint's SwipeGestureHandler pattern).
    property <length> drawer-rest: drawer-open ? drawer-width : 0px;
    animate drawer-rest { duration: 220ms; easing: ease-out; }
    property <length> drag-offset;
    property <length> drawer-pos: clamp(drawer-rest + drag-offset, 0px, drawer-width);
    states [
        dragging when swipe.swiping: {
            drag-offset: swipe.current-position.x - swipe.pressed-position.x;
            out {
                animate drag-offset { duration: 220ms; easing: ease-out; }
            }
        }
    ]

    // Stay clear of the phone's status/navigation bars and, while it's
    // open, the on-screen keyboard. All zero on desktop.
    swipe := SwipeGestureHandler {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
        enabled: !root.show-settings;
        // Swipe right (left edge to the right) opens the chat list; swipe
        // left closes it, like a drawer.
        handle-swipe-right: !root.drawer-open;
        handle-swipe-left: root.drawer-open;
        // `swiping` is already false when this runs, so use the finger's
        // travel rather than drag-offset (which is easing back to 0 by now).
        swiped => {
            root.drawer-open = clamp(root.drawer-rest + self.current-position.x - self.pressed-position.x, 0px, root.drawer-width) > root.drawer-width / 3;
        }

        ChatPage {
            open-menu => { root.drawer-open = true; }
        }

        if root.drawer-pos > 0: Rectangle {
            background: #000;
            opacity: 0.45 * root.drawer-pos / root.drawer-width;
            TouchArea {
                clicked => { root.drawer-open = false; }
            }
        }
        if root.drawer-pos > 0: Sidebar {
            x: root.drawer-pos - root.drawer-width;
            width: root.drawer-width;
            height: parent.height;
            close => { root.drawer-open = false; }
            open-settings => {
                root.drawer-open = false;
                root.show-settings = true;
            }
        }
        if root.show-settings: SettingsPage {
            back => { root.show-settings = false; }
        }
    }
}
