// Shared UI for the desktop (ojp) and Android (ojp-android) apps.
// Pure view: state lives in Rust and is pushed in through the `Chat` and
// `Settings` globals; user actions come back out through their callbacks.
import { Button, CheckBox, ComboBox, LineEdit, Palette, ProgressIndicator, ScrollView, Slider, Switch } from "std-widgets.slint";

// One piece of an assistant reply that contains display math: formatted
// text, or a typeset formula (black ink; tinted with the theme colour).
export struct Block {
    text: styled-text,
    image: image,
    is-math: bool,
}

export struct Message {
    from-user: bool,
    // Raw text, as typed or as streamed from the model.
    text: string,
    // Assistant replies rendered from `text` (markdown; LaTeX math turned
    // into Unicode by ojp-core::format) by the Rust side.
    rendered: styled-text,
    // Only when the reply has display math: the pieces to show instead of
    // `rendered`.
    blocks: [Block],
    // Small grey line under a reply: route, timing, notices.
    meta: string,
}

// A paired device, as shown in Settings.
export struct Device {
    name: string,
    // "Phone · online · has a big model" / "Laptop · not reachable".
    status: string,
    // Use this device's AI model when this one has none.
    chat: bool,
    // What it may ask this device to do: 0 off, 1 basic, 2 files and web too.
    ask: int,
    notify: bool,
    sync: bool,
}

export struct ChatSummary {
    id: string,
    title: string,
}

export global Chat {
    in-out property <string> assistant-name: "Jarvis";
    in-out property <[Message]> messages;
    // True while a reply is being generated; input is disabled meanwhile.
    in-out property <bool> busy;
    // One-line status under the header (models loaded, errors).
    in-out property <string> status;
    callback send(string);
    callback clear();

    // Saved chats, most recent first, and the one on screen.
    in-out property <[ChatSummary]> chats;
    in-out property <string> current-chat;
    callback open-chat(string);
    callback delete-chat(string);

    // First-run model download panel.
    in-out property <bool> download-needed;
    in-out property <string> download-text;
    // 0..1 while downloading; negative when not running (shows the button).
    in-out property <float> download-progress: -1;
    // Storage choices (e.g. "Phone storage (54.2 GB free)", "SD card (…)");
    // empty means a single Download button.
    in-out property <[string]> download-targets;
    // Index into download-targets, or -1 for the single button.
    callback download(int);
    // "Also download the main model" checkbox: shown when the main model is
    // among the missing ones; unticked means router only.
    in-out property <bool> offer-main;
    in-out property <string> main-label;
    in-out property <bool> download-main: true;
}

export global Settings {
    // 0 = follow the system, 1 = light, 2 = dark.
    in-out property <int> theme;
    in-out property <bool> dynamic-colors: true;
    // Only Android has wallpaper-based colours.
    in-out property <bool> dynamic-colors-supported;
    // Android only: optional Shizuku support (see ojp-core::platform).
    in-out property <bool> shizuku-supported: false;
    in-out property <string> shizuku-text;
    callback shizuku-action();
    // Whether the chosen model's files are on this device, with a button to fetch them.
    in property <string> version;
    in-out property <string> model-note;
    in-out property <bool> model-needs-download;
    callback download-now();
    // Where chat answers are written: 0 this device (default), 1 a paired device's bigger model when this one has none,
    // 2 a paired device's model whenever reachable.
    in-out property <int> brain;
    callback brain-changed(int);
    // Paired devices (see ojp-core::link) and the pairing dialog's state.
    in-out property <[Device]> devices;
    // Shown while this device waits for another to enter it.
    in-out property <string> pair-code;
    in-out property <string> pair-message;
    in-out property <bool> pair-busy;
    in-out property <bool> link-supported: true;
    callback pair-host();
    callback pair-join(string);
    callback unpair(string);
    // name, chat, ask, notify, sync
    callback device-changed(string, bool, int, bool, bool);
    // 0 = classic (Qwen2.5 0.5B router + main), 1 = uncensored Qwen3.5-0.8B.
    in-out property <int> profile;
    // Developer: false = router only, the main model is never loaded.
    in-out property <bool> main-enabled: true;
    // Speak replies aloud. Only where the build has a voice.
    in-out property <bool> tts-enabled: false;
    in-out property <bool> tts-supported: false;
    // Voice choices for the blend; index 0 of `tts-voice-choices` is "None".
    in-out property <[string]> tts-voice-choices;
    // Up to three voices blended: a choice and a strength 0..10 for each.
    in-out property <int> mix-v0;
    in-out property <float> mix-a0: 10;
    in-out property <int> mix-v1;
    in-out property <float> mix-a1;
    in-out property <int> mix-v2;
    in-out property <float> mix-a2;
    out property <float> mix-total: (mix-v0 > 0 ? mix-a0 : 0) + (mix-v1 > 0 ? mix-a1 : 0) + (mix-v2 > 0 ? mix-a2 : 0);
    // Play a sample in the current voice, speed and blend.
    callback preview();
    in-out property <[string]> tts-clarities;
    in-out property <int> tts-clarity;
    in-out property <[string]> tts-engines;
    in-out property <int> tts-engine;
    in-out property <[string]> tts-moss-voices;
    in-out property <int> tts-moss-voice;
    in-out property <[string]> tts-speeds;
    in-out property <int> tts-speed;
    // Read-only details shown in the developer section.
    in-out property <string> info;
    // Any of the above changed by the user; the host saves and applies it.
    callback changed();
    // The theme resolved to dark (true) or light (false); the host adapts
    // the system status-bar icons.
    callback dark-changed(bool);
}

component IconButton inherits Rectangle {
    in property <image> icon;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Palette.alternate-background : transparent;
    Image {
        source: root.icon;
        width: 24px;
        height: 24px;
        colorize: Palette.foreground;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Bubble inherits Rectangle {
    in property <Message> message;
    background: message.from-user ? Palette.accent-background : Palette.alternate-background;
    border-radius: 14px;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;
        if message.from-user: Text {
            text: message.text;
            wrap: word-wrap;
            color: Palette.accent-foreground;
        }
        if !message.from-user && message.blocks.length == 0: StyledText {
            text: message.rendered;
            default-color: Palette.foreground;
            link-color: Palette.accent-background;
        }
        if !message.from-user && message.blocks.length > 0: VerticalLayout {
            spacing: 6px;
            for block in message.blocks: VerticalLayout {
                if !block.is-math: StyledText {
                    text: block.text;
                    default-color: Palette.foreground;
                    link-color: Palette.accent-background;
                }
                if block.is-math: Rectangle {
                    // Rendered at twice the logical size; shrinks (keeping
                    // its proportions) if the bubble is narrower.
                    property <length> shown-width: min(block.image.width * 0.5px, self.width);
                    height: self.shown-width * block.image.height / max(block.image.width, 1);
                    Image {
                        x: 0px;
                        y: 0px;
                        width: parent.shown-width;
                        height: parent.height;
                        source: block.image;
                        colorize: Palette.foreground;
                        image-fit: contain;
                    }
                }
            }
        }
        if message.meta != "": Text {
            text: message.meta;
            wrap: word-wrap;
            font-size: 0.8rem;
            color: message.from-user ? Palette.accent-foreground : Palette.foreground;
            opacity: 0.6;
        }
    }
}

component ChatPage inherits Rectangle {
    callback open-menu;
    // The chat list is always visible beside the chat, so no menu button.
    in property <bool> docked;
    background: Palette.background;

    function submit() {
        if (input.text != "" && !Chat.busy) {
            Chat.send(input.text);
            input.text = "";
        }
    }

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 4px;
            vertical-stretch: 0;
            if !root.docked: IconButton {
                icon: @image-url("../assets/menu.png");
                clicked => { root.open-menu(); }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                Text {
                    text: Chat.assistant-name;
                    font-size: 1.4rem;
                    font-weight: 700;
                }
                if Chat.status != "": Text {
                    text: Chat.status;
                    font-size: 0.8rem;
                    opacity: 0.6;
                    overflow: elide;
                }
            }
            Button {
                text: "New chat";
                enabled: !Chat.busy;
                clicked => { Chat.clear(); }
            }
        }

        // Not a ListView: a ListView only instantiates visible rows and
        // re-estimates its height while scrolling, which the auto-scroll
        // below then mistook for new content (you couldn't scroll up).
        list := ScrollView {
            vertical-stretch: 1;
            // Follow new text only while the user is at the bottom; scrolling
            // up to read older messages stops following.
            property <bool> follow: true;
            scrolled => {
                self.follow = self.content-y <= self.visible-height - self.content-height + 24px;
            }
            changed content-height => {
                if (self.follow) {
                    self.content-y = min(0px, self.visible-height - self.content-height);
                }
            }
            VerticalLayout {
                padding-top: 4px;
                padding-bottom: 4px;
                alignment: start;
                for message in Chat.messages: HorizontalLayout {
                    // Indent from the opposite side so user and assistant
                    // messages read as two columns.
                    padding-left: message.from-user ? 56px : 12px;
                    padding-right: message.from-user ? 12px : 56px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    Bubble { message: message; }
                }
            }
        }

        if Chat.download-needed: HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 4px;
            vertical-stretch: 0;
            Rectangle {
                background: Palette.alternate-background;
                border-radius: 14px;
                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;
                    Text {
                        text: Chat.download-text;
                        wrap: word-wrap;
                    }
                    // CheckBox text can't wrap (it would widen the panel past a
                    // phone screen), so the label is a separate wrapping Text
                    // that toggles the box too.
                    if Chat.download-progress < 0 && Chat.offer-main: HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            horizontal-stretch: 0;
                            checked <=> Chat.download-main;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: Chat.main-label;
                                    wrap: word-wrap;
                                }
                            }
                            TouchArea {
                                clicked => { Chat.download-main = !Chat.download-main; }
                            }
                        }
                    }
                    if Chat.download-progress >= 0: ProgressIndicator {
                        progress: Chat.download-progress;
                    }
                    if Chat.download-progress < 0 && Chat.download-targets.length == 0: Button {
                        text: "Download";
                        primary: true;
                        clicked => { Chat.download(-1); }
                    }
                    if Chat.download-progress < 0: VerticalLayout {
                        spacing: 8px;
                        for target[index] in Chat.download-targets: Button {
                            text: target;
                            primary: index == 0;
                            clicked => { Chat.download(index); }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            padding: 10px;
            spacing: 8px;
            vertical-stretch: 0;
            input := LineEdit {
                horizontal-stretch: 1;
                placeholder-text: "Message " + Chat.assistant-name;
                enabled: !Chat.busy;
                accepted => { root.submit(); }
            }
            Button {
                text: "Send";
                enabled: !Chat.busy && input.text != "";
                clicked => { root.submit(); }
            }
        }
    }
}

component Sidebar inherits Rectangle {
    callback close;
    callback open-settings;
    background: Palette.alternate-background;

    VerticalLayout {
        padding: 12px;
        spacing: 8px;
        Text {
            text: "Chats";
            font-size: 1.3rem;
            font-weight: 700;
        }
        Button {
            text: "New chat";
            primary: true;
            enabled: !Chat.busy;
            clicked => {
                Chat.clear();
                root.close();
            }
        }
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                alignment: start;
                spacing: 2px;
                if Chat.chats.length == 0: Text {
                    text: "No saved chats yet.";
                    opacity: 0.6;
                }
                for chat in Chat.chats: Rectangle {
                    height: 44px;
                    border-radius: 10px;
                    background: chat.id == Chat.current-chat ? Palette.control-background : (row-touch.pressed ? Palette.background : transparent);
                    row-touch := TouchArea {
                        enabled: !Chat.busy;
                        clicked => {
                            Chat.open-chat(chat.id);
                            root.close();
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 4px;
                        Text {
                            horizontal-stretch: 1;
                            text: chat.title;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        IconButton {
                            icon: @image-url("../assets/delete.png");
                            clicked => { Chat.delete-chat(chat.id); }
                        }
                    }
                }
            }
        }
        Rectangle {
            height: 44px;
            border-radius: 10px;
            background: settings-touch.pressed ? Palette.background : transparent;
            settings-touch := TouchArea {
                clicked => { root.open-settings(); }
            }
            HorizontalLayout {
                padding-left: 10px;
                spacing: 10px;
                Image {
                    source: @image-url("../assets/settings.png");
                    width: 22px;
                    colorize: Palette.foreground;
                }
                Text {
                    text: "Settings";
                    vertical-alignment: center;
                }
            }
        }
    }
}

// One voice of the blend: which voice and how strong.
component MixRow inherits VerticalLayout {
    in property <string> title;
    in property <[string]> choices;
    in property <float> total;
    in-out property <int> voice;
    in-out property <float> amount;
    callback edited();
    spacing: 4px;
    HorizontalLayout {
        spacing: 12px;
        Text {
            text: root.title;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        ComboBox {
            horizontal-stretch: 0;
            model: root.choices;
            current-index <=> root.voice;
            selected => { root.edited(); }
        }
    }
    if root.voice > 0: HorizontalLayout {
        spacing: 12px;
        Slider {
            minimum: 0;
            maximum: 10;
            value <=> root.amount;
            released => { root.edited(); }
        }
        Text {
            width: 44px;
            text: root.total > 0 ? "\{Math.round(100 * root.amount / root.total)}%" : "0%";
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// One of a few exclusive choices, written out in full (a drop-down list is only as wide as its button, which
// cuts long options off on a phone).
component ChoiceRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    callback chosen;
    background: root.selected ? Palette.accent-background.transparentize(0.88) : transparent;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.selected ? Palette.accent-background : Palette.border;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 0;
            padding-top: 2px;
            alignment: start;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: root.selected ? Palette.accent-background : Palette.border;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.selected ? Palette.accent-background : transparent;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px;
            Text { text: root.title; wrap: word-wrap; font-weight: 700; }
            Text { text: root.description; wrap: word-wrap; font-size: 0.85rem; opacity: 0.7; }
        }
    }
    TouchArea { clicked => { root.chosen(); } }
}

component SettingRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    in-out property <bool> checked;
    callback toggled;
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        Text { text: root.title; }
        if root.description != "": Text {
            text: root.description;
            wrap: word-wrap;
            font-size: 0.85rem;
            opacity: 0.65;
        }
    }
    Switch {
        horizontal-stretch: 0;
        checked <=> root.checked;
        toggled => { root.toggled(); }
    }
}

component SettingsPage inherits Rectangle {
    callback back;
    background: Palette.background;

    VerticalLayout {
        HorizontalLayout {
            padding: 8px;
            spacing: 8px;
            vertical-stretch: 0;
            Button {
                text: "‹ Back";
                horizontal-stretch: 0;
                clicked => { root.back(); }
            }
            Text {
                text: "Settings";
                font-size: 1.3rem;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        ScrollView {
            vertical-stretch: 1;
            mouse-drag-pan-enabled: true;
            VerticalLayout {
                padding: 16px;
                spacing: 14px;
                alignment: start;

                Text { text: "OpenJarvis " + Settings.version; font-size: 0.8rem; opacity: 0.6; }
                Text { text: "Model"; font-weight: 700; color: Palette.accent-background; }
                ChoiceRow {
                    title: "Classic (Qwen2.5)";
                    description: "A small router model plus a bigger main model that writes the answers.";
                    selected: Settings.profile == 0;
                    chosen => { Settings.profile = 0; Settings.changed(); }
                }
                ChoiceRow {
                    title: "Uncensored (Qwen3.5 0.8B)";
                    description: "One small model (about 400 MB) with no content filter, used for everything, including the routing.";
                    selected: Settings.profile == 1;
                    chosen => { Settings.profile = 1; Settings.changed(); }
                }
                Text { text: Settings.model-note; wrap: word-wrap; font-size: 0.85rem; }
                if Chat.download-progress >= 0: ProgressIndicator { progress: Chat.download-progress; }
                if Chat.download-progress >= 0: Text { text: Chat.download-text; wrap: word-wrap; font-size: 0.85rem; opacity: 0.7; }
                if Settings.model-needs-download && Chat.download-progress < 0: Button {
                    text: "Download the model";
                    primary: true;
                    clicked => { Settings.download-now(); }
                }

                Rectangle { height: 1px; background: Palette.border; opacity: 0.4; }

                if Settings.shizuku-supported: VerticalLayout {
                    spacing: 8px;
                    Text { text: "Phone control (optional)"; font-weight: 700; color: Palette.accent-background; }
                    Text {
                        text: "Volume, apps, links, reminders and battery work as they are. With Shizuku (a free helper app that gives other apps adb's rights once you start it), the assistant can also switch Wi-Fi, Bluetooth and airplane mode, set brightness, take screenshots and run commands (it always asks before a command).";
                        wrap: word-wrap;
                        font-size: 0.85rem;
                        opacity: 0.65;
                    }
                    Text { text: Settings.shizuku-text; wrap: word-wrap; }
                    Button {
                        text: "Allow with Shizuku";
                        clicked => { Settings.shizuku-action(); }
                    }
                    Rectangle { height: 1px; background: Palette.border; opacity: 0.4; }
                }

                if Settings.link-supported: VerticalLayout {
                    spacing: 14px;
                    Text { text: "Devices"; font-weight: 700; color: Palette.accent-background; }
                    Text {
                        text: "Pair your other devices by hand so they work as one assistant: a phone without a big model can use your computer's, and \"remind me on my phone\" really happens on the phone. Only devices you pair can connect.";
                        wrap: word-wrap;
                        font-size: 0.85rem;
                        opacity: 0.65;
                    }
                    Text { text: "Where answers are written"; font-weight: 700; }
                    ChoiceRow {
                        title: "On this device";
                        description: "Default. This device's own model writes every answer.";
                        selected: Settings.brain == 0;
                        chosen => { Settings.brain = 0; Settings.brain-changed(0); }
                    }
                    ChoiceRow {
                        title: "Borrow a bigger model if I have none";
                        description: "If this device only has the small model, a paired device's bigger model writes the answer. If it can't be reached, this device answers.";
                        selected: Settings.brain == 1;
                        chosen => { Settings.brain = 1; Settings.brain-changed(1); }
                    }
                    ChoiceRow {
                        title: "Prefer a paired device";
                        description: "A paired device's model writes answers whenever one is reachable, even if this device has its own model.";
                        selected: Settings.brain == 2;
                        chosen => { Settings.brain = 2; Settings.brain-changed(2); }
                    }
                    Text {
                        text: "Either way, a request runs on this device unless you name another one (\"remind me on my phone ...\", \"ask my laptop ...\").";
                        wrap: word-wrap;
                        font-size: 0.85rem;
                        opacity: 0.65;
                    }
                    for device[i] in Settings.devices: VerticalLayout {
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text { text: device.name; font-weight: 700; }
                                Text { text: device.status; font-size: 0.85rem; opacity: 0.65; wrap: word-wrap; }
                            }
                            Button {
                                text: "Remove";
                                horizontal-stretch: 0;
                                clicked => { Settings.unpair(device.name); }
                            }
                        }
                        SettingRow {
                            title: "Use its AI model";
                            description: "When this device has no big model of its own.";
                            checked: device.chat;
                            toggled => { Settings.device-changed(device.name, !device.chat, device.ask, device.notify, device.sync); }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            Text { text: "May ask this device to do things"; horizontal-stretch: 1; vertical-alignment: center; wrap: word-wrap; }
                            ComboBox {
                                horizontal-stretch: 0;
                                model: ["Nothing", "Basic", "Files & web", "Everything"];
                                current-index: device.ask;
                                selected(choice) => {
                                    Settings.device-changed(device.name, device.chat, choice == "Nothing" ? 0 : choice == "Basic" ? 1 : choice == "Everything" ? 3 : 2, device.notify, device.sync);
                                }
                            }
                        }
                        Text {
                            text: device.ask == 0 ? "It can't ask this device to do anything." : device.ask == 1 ? "It can ask for timers, reminders, notes, volume, media, the time, status and memory." : device.ask == 2 ? "Basic, plus reading files, the clipboard and the web." : "Anything, but every risky action (writing files, running commands) asks you first, on the device that asked.";
                            wrap: word-wrap;
                            font-size: 0.85rem;
                            opacity: 0.65;
                        }
                        SettingRow {
                            title: "May show messages here";
                            checked: device.notify;
                            toggled => { Settings.device-changed(device.name, device.chat, device.ask, !device.notify, device.sync); }
                        }
                        SettingRow {
                            title: "Share memories";
                            description: "What you tell one device is remembered by both; forgetting applies to both.";
                            checked: device.sync;
                            toggled => { Settings.device-changed(device.name, device.chat, device.ask, device.notify, !device.sync); }
                        }
                        Rectangle { height: 6px; }
                        Rectangle { height: 1px; background: Palette.border; opacity: 0.25; }
                    }
                    if Settings.pair-code != "": Text {
                        text: "On the other device, go to Settings > Devices, type this code and tap Pair:  " + Settings.pair-code;
                        wrap: word-wrap;
                        font-weight: 700;
                    }
                    Button {
                        text: "Show a pairing code";
                        enabled: !Settings.pair-busy;
                        clicked => { Settings.pair-host(); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        code-input := LineEdit {
                            placeholder-text: "Code from the other device";
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Pair";
                            horizontal-stretch: 0;
                            enabled: !Settings.pair-busy && code-input.text != "";
                            clicked => { Settings.pair-join(code-input.text); }
                        }
                    }
                    if Settings.pair-message != "": Text {
                        text: Settings.pair-message;
                        wrap: word-wrap;
                        font-size: 0.85rem;
                    }

                }

                Rectangle { height: 1px; background: Palette.border; opacity: 0.4; }

                Text { text: "Appearance"; font-weight: 700; color: Palette.accent-background; }
                HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Theme";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: ["System", "Light", "Dark"];
                        current-index <=> Settings.theme;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.dynamic-colors-supported: SettingRow {
                    title: "Dynamic colours";
                    description: "Tint the app with your wallpaper's colours.";
                    checked <=> Settings.dynamic-colors;
                    toggled => { Settings.changed(); }
                }

                if Settings.tts-supported: SettingRow {
                    title: "Speak replies";
                    description: "Read answers aloud. The first time, the voice (about 340 MB) is downloaded.";
                    checked <=> Settings.tts-enabled;
                    toggled => { Settings.changed(); }
                }
                if Settings.tts-supported && Settings.tts-enabled: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Voice engine";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: Settings.tts-engines;
                        current-index <=> Settings.tts-engine;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 1: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "MOSS voice";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: Settings.tts-moss-voices;
                        current-index <=> Settings.tts-moss-voice;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 0: Text {
                    text: "Voice mix: blend up to three voices; strengths are shared out between them.";
                    wrap: word-wrap;
                    font-size: 0.8rem;
                    opacity: 0.65;
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 0: MixRow {
                    title: "Voice 1";
                    choices: Settings.tts-voice-choices;
                    total: Settings.mix-total;
                    voice <=> Settings.mix-v0;
                    amount <=> Settings.mix-a0;
                    edited => { Settings.changed(); }
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 0: MixRow {
                    title: "Voice 2";
                    choices: Settings.tts-voice-choices;
                    total: Settings.mix-total;
                    voice <=> Settings.mix-v1;
                    amount <=> Settings.mix-a1;
                    edited => { Settings.changed(); }
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 0: MixRow {
                    title: "Voice 3";
                    choices: Settings.tts-voice-choices;
                    total: Settings.mix-total;
                    voice <=> Settings.mix-v2;
                    amount <=> Settings.mix-a2;
                    edited => { Settings.changed(); }
                }
                if Settings.tts-supported && Settings.tts-enabled && Settings.tts-engine == 0: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Speaking speed";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: Settings.tts-speeds;
                        current-index <=> Settings.tts-speed;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.tts-supported && Settings.tts-enabled: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "Voice clarity";
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        horizontal-stretch: 0;
                        model: Settings.tts-clarities;
                        current-index <=> Settings.tts-clarity;
                        selected => { Settings.changed(); }
                    }
                }
                if Settings.tts-supported && Settings.tts-enabled: Text {
                    text: "Sharpens consonants so speech sounds less slurred. Lower it if it sounds too crisp.";
                    wrap: word-wrap;
                    font-size: 0.8rem;
                    opacity: 0.65;
                }
                if Settings.tts-supported && Settings.tts-enabled: Button {
                    text: "Play a sample";
                    clicked => { Settings.preview(); }
                }

                Rectangle { height: 1px; background: Palette.border; opacity: 0.4; }

                Text { text: "Developer"; font-weight: 700; color: Palette.accent-background; }
                SettingRow {
                    title: "Use the main model";
                    description: "Off: only the small router model is loaded and answers everything (less memory, weaker answers).";
                    checked <=> Settings.main-enabled;
                    toggled => { Settings.changed(); }
                }
                Text {
                    text: Settings.info;
                    wrap: word-wrap;
                    font-size: 0.8rem;
                    opacity: 0.65;
                }
                // Room under the last item, so it can be scrolled clear of the phone's navigation bar.
                Rectangle { height: 140px; }
            }
        }
    }
}

export component AppWindow inherits Window {
    // App name; the assistant's own name (persona) is shown in the header.
    title: "OpenJarvis";
    icon: @image-url("../assets/openjarvis-256.png");
    // A normal desktop window by default; phones ignore the preferred size.
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 320px;
    min-height: 420px;
    background: Palette.background;

    // Wide windows keep the chat list docked on the left instead of in the
    // swipe-open drawer.
    property <bool> wide: root.width >= 720px;
    property <length> docked-width: 300px;

    property <int> theme: Settings.theme;
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    init => { root.apply-theme(); Settings.dark-changed(root.dark); }
    changed theme => { root.apply-theme(); }
    changed dark => { Settings.dark-changed(root.dark); }
    function apply-theme() {
        Palette.color-scheme = root.theme == 1 ? ColorScheme.light : root.theme == 2 ? ColorScheme.dark : ColorScheme.unknown;
    }

    in-out property <bool> show-settings;
    property <length> drawer-width: min(320px, root.width * 0.82);
    property <bool> drawer-open;
    // Where the drawer rests (0 = closed, drawer-width = open), animated
    // when it changes, plus the live finger offset while swiping. On
    // release the offset eases back to 0 while the resting position eases
    // to its new value, so the drawer continues from under the finger
    // instead of jumping (Slint's SwipeGestureHandler pattern).
    property <length> drawer-rest: drawer-open ? drawer-width : 0px;
    animate drawer-rest { duration: 220ms; easing: ease-out; }
    property <length> drag-offset;
    property <length> drawer-pos: clamp(drawer-rest + drag-offset, 0px, drawer-width);
    states [
        dragging when swipe.swiping: {
            drag-offset: swipe.current-position.x - swipe.pressed-position.x;
            out {
                animate drag-offset { duration: 220ms; easing: ease-out; }
            }
        }
    ]

    // Stay clear of the phone's status/navigation bars and, while it's
    // open, the on-screen keyboard. All zero on desktop.
    swipe := SwipeGestureHandler {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - max(root.safe-area-insets.bottom, root.virtual-keyboard-size.height);
        enabled: !root.show-settings && !root.wide;
        // Swipe right (left edge to the right) opens the chat list; swipe
        // left closes it, like a drawer.
        handle-swipe-right: !root.drawer-open;
        handle-swipe-left: root.drawer-open;
        // `swiping` is already false when this runs, so use the finger's
        // travel rather than drag-offset (which is easing back to 0 by now).
        swiped => {
            root.drawer-open = clamp(root.drawer-rest + self.current-position.x - self.pressed-position.x, 0px, root.drawer-width) > root.drawer-width / 3;
        }

        ChatPage {
            x: root.wide ? root.docked-width : 0px;
            width: parent.width - self.x;
            docked: root.wide;
            open-menu => { root.drawer-open = true; }
        }

        if root.drawer-pos > 0 && !root.wide: Rectangle {
            background: #000;
            opacity: 0.45 * root.drawer-pos / root.drawer-width;
            TouchArea {
                clicked => { root.drawer-open = false; }
            }
        }
        if root.drawer-pos > 0 || root.wide: Sidebar {
            x: root.wide ? 0px : root.drawer-pos - root.drawer-width;
            width: root.wide ? root.docked-width : root.drawer-width;
            height: parent.height;
            close => { root.drawer-open = false; }
            open-settings => {
                root.drawer-open = false;
                root.show-settings = true;
            }
        }
        if root.show-settings: SettingsPage {
            back => { root.show-settings = false; }
        }
    }
}
